// Esquema del dashboard IoT del robot aspirador.
// SQLite no soporta enums: se usan String validados con Zod en /lib/schemas.ts.
// Modo:      EN_BASE | LIMPIANDO | PAUSADO | CARGANDO | ATASCADO | OFFLINE
// Severidad: INFO | ADVERTENCIA | CRITICO
// Potencia:  ECO | NORMAL | TURBO
// ZonaWifi:  CERCA | MEDIA | LEJOS
// Patron:    ZIGZAG | ESPIRAL | PERIMETRO | ALEATORIO
// Senal:     DIST_FRONTAL | DIST_IZQ | DIST_DER | POLVO | COBERTURA | RSSI

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Device {
  id             String        @id @default("robot-1")
  nombre         String        @default("Roomba UNI")
  modo           String        @default("EN_BASE")
  bateriaPct     Float         @default(100)
  voltaje        Float         @default(14.4)
  rssi           Int           @default(-52)
  zonaWifi       String        @default("CERCA")
  online         Boolean       @default(true)
  ultimaConexion DateTime      @default(now())
  arranqueAt     DateTime      @default(now())
  fwVersion      String        @default("0.1.0")
  config         Config?
  calibracion    Calibracion?
  sesiones       Session[]
  schedules      Schedule[]
  consumibles    Maintenance[]
}

model Config {
  id                String   @id @default(cuid())
  deviceId          String   @unique
  device            Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  potenciaSuccion   String   @default("NORMAL")
  velocidadMs       Float    @default(0.25)
  umbralFrontalCm   Float    @default(20)
  umbralLateralCm   Float    @default(12)
  duracionGiroS     Float    @default(0.6)
  patron            String   @default("ZIGZAG")
  duracionMaxMin    Int      @default(45)
  bateriaRetornoPct Float    @default(20)
  factorZonaSucia   Float    @default(1.5)
  segundaPasada     Boolean  @default(true)
  terminarAlLimpiar Boolean  @default(false)
  pmObjetivo        Float    @default(0.08)
  telemetriaHz      Float    @default(2)
  modoSilencioso    Boolean  @default(false)
  silencioDesde     String   @default("22:00")
  silencioHasta     String   @default("07:00")
  updatedAt         DateTime @updatedAt
}

model Calibracion {
  id              String   @id @default(cuid())
  deviceId        String   @unique
  device          Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  mmPorPulso      Float    @default(10.2)
  distanciaEjesMm Float    @default(150)
  anchoCepilloM   Float    @default(0.18)
  pulsosPorMetro  Float    @default(98.04)
  rssiCerca       Int      @default(-45)
  rssiMedia       Int      @default(-62)
  pmBaseline      Float    @default(0.05)
  updatedAt       DateTime @updatedAt
}

model Thresholds {
  id                  String   @id @default("default")
  bateriaBajaPct      Float    @default(20)
  pmMaxTolerado       Float    @default(0.4)
  caidaTensionVPorMin Float    @default(0.06)
  horasFiltro         Float    @default(120)
  horasCepillo        Float    @default(80)
  minSinTelemetria    Int      @default(2)
  updatedAt           DateTime @updatedAt
}

model Session {
  id             String      @id @default(cuid())
  deviceId       String
  device         Device      @relation(fields: [deviceId], references: [id])
  inicio         DateTime    @default(now())
  fin            DateTime?
  duracionS      Int?
  areaM2         Float       @default(0)
  distanciaM     Float       @default(0)
  pmInicial      Float?
  pmFinal        Float?
  efectividadPct Float?
  bateriaInicial Float?
  bateriaFinal   Float?
  obstaculos     Int         @default(0)
  potencia       String      @default("NORMAL")
  patron         String      @default("ZIGZAG")
  resultado      String?
  motivoCierre   String?
  telemetria     Telemetry[]
  eventos        Event[]

  @@index([inicio])
}

model Telemetry {
  id              String   @id @default(cuid())
  sessionId       String?
  session         Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp       DateTime @default(now())
  n               Int
  senal           String
  x               Float
  valorAproximado Float
  valorReal       Float
  errorAbsoluto   Float
  errorRelativo   Float
  valorFisico     Float
  pulsosIzq       Int?
  pulsosDer       Int?
  voltaje         Float?
  bateriaPct      Float?
  rssi            Int?
  velocidadMs     Float?
  anguloGirado    Float?

  @@index([sessionId, timestamp])
  @@index([senal, n])
  @@index([timestamp])
}

model Event {
  id        String   @id @default(cuid())
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  timestamp DateTime @default(now())
  tipo      String
  severidad String
  sensor    String?
  valor     Float?
  unidad    String?
  accion    String?
  detalle   String?

  @@index([timestamp])
  @@index([tipo, severidad])
}

model Alert {
  id         String    @id @default(cuid())
  tipo       String
  severidad  String
  mensaje    String
  valor      Float?
  creadaAt   DateTime  @default(now())
  resueltaAt DateTime?

  @@index([resueltaAt])
}

model Schedule {
  id              String        @id @default(cuid())
  deviceId        String
  device          Device        @relation(fields: [deviceId], references: [id])
  nombre          String        @default("Limpieza")
  dias            String
  hora            String
  duracionMaxMin  Int           @default(45)
  potencia        String        @default("NORMAL")
  patron          String        @default("ZIGZAG")
  saltarSiBateria Boolean       @default(true)
  bateriaMinPct   Float         @default(30)
  activo          Boolean       @default(true)
  ejecuciones     ScheduleRun[]
}

model ScheduleRun {
  id         String    @id @default(cuid())
  scheduleId String
  schedule   Schedule  @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  programada DateTime
  ejecutada  DateTime?
  retrasoS   Int?
  resultado  String
  motivo     String?
  sessionId  String?

  @@index([programada])
}

model Maintenance {
  id          String   @id @default(cuid())
  deviceId    String
  device      Device   @relation(fields: [deviceId], references: [id])
  consumible  String
  horasUso    Float    @default(0)
  horasVida   Float
  ultimoReset DateTime @default(now())

  @@unique([deviceId, consumible])
}
