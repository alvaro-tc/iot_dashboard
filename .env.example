# Copia este archivo a .env en la raíz del repo. Ambas apps lo leen desde aquí.

# --- Postgres (docker compose publica el contenedor en 5433) ---
DATABASE_URL=postgres://iot:iot@localhost:5433/iot

# --- MQTT ---
# URL con la que el backend se conecta al broker.
MQTT_URL=mqtt://localhost:1883
# Usuario de servicio del backend: se suscribe a telemetry/+/+ y publica el simulador web.
# El backend lo escribe en el archivo passwd al arrancar.
MQTT_ADMIN_USER=iot-backend
MQTT_ADMIN_PASS=cambia-esta-clave
# Host que verá el ESP32 en el fragmento de firmware (la IP de tu PC en la LAN). Opcional:
# por defecto usa el host de MQTT_URL, que desde un ESP32 no suele servir.
MQTT_PUBLIC_HOST=192.168.1.100

# Rutas en el host de los archivos que monta el contenedor de Mosquitto.
MOSQUITTO_PASSWD_PATH=./mosquitto/passwd
MOSQUITTO_ACL_PATH=./mosquitto/acl
# Comando que envía SIGHUP a Mosquitto para recargar credenciales.
# En el VPS (sin Docker): sudo systemctl reload mosquitto
MOSQUITTO_RELOAD_CMD=docker kill -s HUP mosquitto

# --- API ---
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
PORT=4000
# Una sesión activa sin muestras durante este tiempo se cierra sola.
RUN_IDLE_TIMEOUT_MS=120000

# --- Web (Vite solo expone variables VITE_*) ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=ws://localhost:4000/ws
